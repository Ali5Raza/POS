@model PaginatedList<Product>
@{
    ViewData["Title"] = "Inventory Valuation & Stock";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h4 class="fw-bold mb-0">Inventory &amp; Stock Valuation</h4>
        <span class="text-muted small">Monitor current stock, reorder levels, cost valuation and retail valuation across all products</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Ledger" class="btn btn-outline-primary btn-sm fw-semibold">
            <i class="bi bi-journal-text me-1"></i> Stock Ledger
        </a>
        @if (User.HasPermission(PermissionCodes.AdjustInventory))
        {
            <a asp-action="Adjustments" class="btn btn-primary btn-sm fw-semibold">
                <i class="bi bi-sliders me-1"></i> Stock Adjustment
            </a>
        }
    </div>
</div>

<!-- Valuation Summary Strip (Clickable Filters) -->
<div class="row g-3 mb-3">
    <div class="col-md-3">
        <a asp-action="Index" class="kpi-card kpi-card-link border-start border-4 border-primary h-100">
            <div class="kpi-label">Total Stock Value (Cost)</div>
            <div class="kpi-value text-primary">@(((decimal)(ViewBag.TotalCostValuation ?? 0m)).ToString("N2"))</div>
            <div class="small text-muted mt-1">Click to view all items</div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-action="Index" asp-route-stockFilter="instock" class="kpi-card kpi-card-link border-start border-4 border-success h-100">
            <div class="kpi-label">Total Retail Value</div>
            <div class="kpi-value text-success">@(((decimal)(ViewBag.TotalRetailValuation ?? 0m)).ToString("N2"))</div>
            <div class="small text-muted mt-1">Click to filter In-Stock</div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-action="Index" asp-route-stockFilter="low" class="kpi-card kpi-card-link border-start border-4 border-warning h-100">
            <div class="kpi-label">Low Stock Items</div>
            <div class="kpi-value text-warning">@ViewBag.LowStockCount</div>
            <div class="small text-muted mt-1">Click to filter Low Stock &rarr;</div>
        </a>
    </div>
    <div class="col-md-3">
        <a asp-action="Index" asp-route-stockFilter="out" class="kpi-card kpi-card-link border-start border-4 border-danger h-100">
            <div class="kpi-label">Out of Stock Items</div>
            <div class="kpi-value text-danger">@ViewBag.OutOfStockCount</div>
            <div class="small text-danger fw-semibold mt-1">Click to view Out of Stock &rarr;</div>
        </a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search Product, SKU, Barcode..." />
            </div>
            <div class="col-md-3">
                <select name="categoryId" asp-items="@ViewBag.Categories" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Categories</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="stockFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Stock Statuses</option>
                    <option value="instock" selected="@(ViewBag.StockFilter == "instock")">In Stock (&gt; 0)</option>
                    <option value="low" selected="@(ViewBag.StockFilter == "low")">Low Stock</option>
                    <option value="out" selected="@(ViewBag.StockFilter == "out")">Out of Stock (0)</option>
                    <option value="low_or_out" selected="@(ViewBag.StockFilter == "low_or_out")">Low + Out of Stock</option>
                    <option value="reorder" selected="@(ViewBag.StockFilter == "reorder")">At / Below Reorder Level</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Barcode</th>
                    <th class="text-end">Current Stock</th>
                    <th class="text-end">Min Stock</th>
                    <th class="text-end">Reorder Level</th>
                    <th class="text-end">Unit Cost</th>
                    <th class="text-end">Stock Value</th>
                    <th class="text-end">Retail Value</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="10" class="text-center text-muted py-4">No products found matching this filter.</td></tr>
                }
                @foreach (var p in Model)
                {
                    var stockVal = Math.Max(0, p.CurrentStock) * p.CostPrice;
                    var retailVal = Math.Max(0, p.CurrentStock) * p.SalePrice;
                    <tr>
                        <td>
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" class="fw-semibold text-decoration-none text-dark">@p.Name</a>
                            @if (p.CurrentStock <= 0)
                            {
                                <span class="badge bg-danger ms-1">Out of Stock</span>
                            }
                            else if (p.CurrentStock <= p.MinimumStockLevel)
                            {
                                <span class="badge bg-warning text-dark ms-1">Low Stock</span>
                            }
                        </td>
                        <td>@p.SKU</td>
                        <td><small class="text-muted">@p.Barcode</small></td>
                        <td class="text-end fw-bold @(p.CurrentStock <= 0 ? "text-danger" : p.CurrentStock <= p.MinimumStockLevel ? "text-warning" : "text-success")">
                            @p.CurrentStock.ToString("N0") @p.Unit
                        </td>
                        <td class="text-end">@p.MinimumStockLevel.ToString("N0")</td>
                        <td class="text-end">@p.ReorderLevel.ToString("N0")</td>
                        <td class="text-end">@p.CostPrice.ToString("N2")</td>
                        <td class="text-end fw-bold">@stockVal.ToString("N2")</td>
                        <td class="text-end text-primary fw-semibold">@retailVal.ToString("N2")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" class="btn btn-outline-primary py-0 px-2" title="Product Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Ledger" asp-route-productId="@p.Id" class="btn btn-outline-secondary py-0 px-2" title="Stock Ledger">
                                    <i class="bi bi-journal-text"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
