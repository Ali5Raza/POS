@model PaginatedList<Expense>
@{
    ViewData["Title"] = "Store Expenses";
    var categoryList = ViewBag.CategoryList as List<ExpenseCategory> ?? new List<ExpenseCategory>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">Operating Expenses</h4>
        <span class="text-muted small">Track store expenses (Rent, Electricity, Salary, Transport, Internet, Maintenance, Office, Miscellaneous)</span>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-warning text-dark fs-6 px-3 py-2">Total Filtered: @(((decimal)(ViewBag.TotalFilteredExpenses ?? 0m)).ToString("N2"))</span>
        @if (User.HasPermission(PermissionCodes.CreateExpense))
        {
            <button type="button" class="btn btn-outline-secondary btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#newExpCatModal">
                <i class="bi bi-folder-plus me-1"></i> Add Expense Category
            </button>
        }
    </div>
</div>

<div class="row g-3">
    @if (User.HasPermission(PermissionCodes.CreateExpense))
    {
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-wallet2 me-2 text-primary"></i>Record New Expense</h6>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Expense Category *</label>
                            <select name="ExpenseCategoryId" class="form-select" required>
                                @foreach (var c in categoryList.Where(x => x.IsActive))
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Expense Date *</label>
                            <input type="date" name="ExpenseDate" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Description *</label>
                            <input type="text" name="Description" class="form-control" placeholder="e.g., Monthly electricity bill" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Amount *</label>
                            <input type="number" name="Amount" step="0.01" min="0.01" class="form-control fw-bold" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Payment Method</label>
                            <select name="PaymentMethod" class="form-select">
                                <option value="Cash">Cash</option>
                                <option value="Bank Transfer">Bank Transfer</option>
                                <option value="Card">Card</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Reference #</label>
                            <input type="text" name="ReferenceNumber" class="form-control" placeholder="Receipt / Bill #" />
                        </div>
                        <button type="submit" class="btn btn-primary w-100 fw-bold">Save Expense</button>
                    </form>
                </div>
            </div>
        </div>
    }

    <div class="@(User.HasPermission(PermissionCodes.CreateExpense) ? "col-lg-8" : "col-12")">
        <div class="card mb-3">
            <div class="card-body py-2">
                <form method="get" class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search EXP # or description..." />
                    </div>
                    <div class="col-md-3">
                        <select name="categoryId" asp-items="@ViewBag.Categories" class="form-select form-select-sm">
                            <option value="">All Categories</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-2 d-flex gap-1">
                        <button type="submit" class="btn btn-sm btn-primary w-100">Filter</button>
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Expense #</th>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Description</th>
                            <th>Method</th>
                            <th class="text-end">Amount</th>
                            <th>User</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4">No expenses recorded yet.</td></tr>
                        }
                        @foreach (var e in Model)
                        {
                            <tr>
                                <td class="fw-bold">@e.ExpenseNumber</td>
                                <td>@e.ExpenseDate.ToString("yyyy-MM-dd")</td>
                                <td><span class="badge bg-light text-dark border">@e.ExpenseCategory?.Name</span></td>
                                <td>@e.Description</td>
                                <td>@e.PaymentMethod</td>
                                <td class="text-end fw-bold text-danger">@e.Amount.ToString("N2")</td>
                                <td>@(e.User?.Username ?? "System")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Expense Category Modal -->
<div class="modal fade" id="newExpCatModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateCategory" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Create Expense Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Category Name *</label>
                        <input type="text" name="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Description</label>
                        <input type="text" name="Description" class="form-control" />
                    </div>
                    <input type="hidden" name="IsActive" value="true" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-semibold">Save Category</button>
                </div>
            </form>
        </div>
    </div>
</div>
