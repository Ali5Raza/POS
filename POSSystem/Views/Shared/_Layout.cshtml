@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Dashboard";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Apex Retail POS &amp; Inventory ERP</title>
    <link rel="stylesheet" href="~/vendor/bootstrap/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/vendor/bootstrap-icons/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (isAuthenticated)
{
    <div class="app-wrapper">
        <!-- Sidebar Navigation -->
        <aside class="app-sidebar" id="appSidebar">
            <a class="sidebar-brand" asp-controller="Dashboard" asp-action="Index">
                <div class="sidebar-brand-icon">AP</div>
                <div>
                    <div class="fw-bold lh-1" style="font-size:0.98rem;">APEX RETAIL</div>
                    <small class="text-info fw-semibold" style="font-size:0.68rem;letter-spacing:0.06em;">POS &amp; INVENTORY ERP</small>
                </div>
            </a>

            <nav class="sidebar-nav">
                @if (User.HasPermission(PermissionCodes.CreateSale))
                {
                    <a class="sidebar-link sidebar-link-pos @(currentController == "POS" ? "active" : "")" asp-controller="POS" asp-action="Index">
                        <i class="bi bi-upc-scan"></i>
                        <span>POS Terminal</span>
                        <span class="ms-auto badge bg-light text-dark" style="font-size:0.65rem;">LIVE</span>
                    </a>
                }

                <a class="sidebar-link @(currentController == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>

                @if (User.HasPermission(PermissionCodes.ViewProducts))
                {
                    <div class="sidebar-section-label">Catalog</div>
                    <a class="sidebar-link @(currentController == "Products" ? "active" : "")" asp-controller="Products" asp-action="Index">
                        <i class="bi bi-box-seam"></i>
                        <span>Products</span>
                    </a>
                    <a class="sidebar-link @(currentController == "Categories" ? "active" : "")" asp-controller="Categories" asp-action="Index">
                        <i class="bi bi-tags"></i>
                        <span>Product Categories</span>
                    </a>
                }

                @if (User.HasPermission(PermissionCodes.ViewPurchases))
                {
                    <div class="sidebar-section-label">Purchasing &amp; Supply</div>
                    <a class="sidebar-link @(currentController == "Suppliers" ? "active" : "")" asp-controller="Suppliers" asp-action="Index">
                        <i class="bi bi-truck"></i>
                        <span>Suppliers</span>
                    </a>
                    <a class="sidebar-link @(currentController == "PurchaseOrders" ? "active" : "")" asp-controller="PurchaseOrders" asp-action="Index">
                        <i class="bi bi-file-earmark-text"></i>
                        <span>Purchase Orders</span>
                    </a>
                    <a class="sidebar-link @(currentController == "Purchases" ? "active" : "")" asp-controller="Purchases" asp-action="Index">
                        <i class="bi bi-bag-check"></i>
                        <span>Purchases</span>
                    </a>
                    <a class="sidebar-link @(currentController == "GoodsReceiving" ? "active" : "")" asp-controller="GoodsReceiving" asp-action="Index">
                        <i class="bi bi-box-arrow-in-down"></i>
                        <span>Goods Receiving (GRN)</span>
                    </a>
                    <a class="sidebar-link @(currentController == "PurchaseReturns" ? "active" : "")" asp-controller="PurchaseReturns" asp-action="Index">
                        <i class="bi bi-arrow-return-left"></i>
                        <span>Purchase Returns</span>
                    </a>
                }

                @if (User.HasPermission(PermissionCodes.ViewSales))
                {
                    <div class="sidebar-section-label">Sales &amp; Customers</div>
                    <a class="sidebar-link @(currentController == "Sales" ? "active" : "")" asp-controller="Sales" asp-action="Index">
                        <i class="bi bi-receipt"></i>
                        <span>Sales Invoices</span>
                    </a>
                    <a class="sidebar-link @(currentController == "SalesReturns" ? "active" : "")" asp-controller="SalesReturns" asp-action="Index">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        <span>Sales Returns</span>
                    </a>
                    <a class="sidebar-link @(currentController == "Customers" ? "active" : "")" asp-controller="Customers" asp-action="Index">
                        <i class="bi bi-people"></i>
                        <span>Customers</span>
                    </a>
                }

                @if (User.HasPermission(PermissionCodes.ViewInventory))
                {
                    <div class="sidebar-section-label">Inventory &amp; Stock</div>
                    <a class="sidebar-link @(currentController == "Inventory" && currentAction == "Index" ? "active" : "")" asp-controller="Inventory" asp-action="Index">
                        <i class="bi bi-boxes"></i>
                        <span>Inventory Valuation</span>
                    </a>
                    <a class="sidebar-link @(currentController == "Inventory" && currentAction == "Ledger" ? "active" : "")" asp-controller="Inventory" asp-action="Ledger">
                        <i class="bi bi-journal-text"></i>
                        <span>Stock Ledger</span>
                    </a>
                    <a class="sidebar-link @(currentController == "Inventory" && currentAction == "Adjustments" ? "active" : "")" asp-controller="Inventory" asp-action="Adjustments">
                        <i class="bi bi-sliders"></i>
                        <span>Stock Management</span>
                    </a>
                }

                @if (User.HasPermission(PermissionCodes.ViewPayments) || User.HasPermission(PermissionCodes.ViewExpenses))
                {
                    <div class="sidebar-section-label">Finance &amp; Accounts</div>
                    @if (User.HasPermission(PermissionCodes.ViewPayments))
                    {
                        <a class="sidebar-link @(currentController == "Payments" ? "active" : "")" asp-controller="Payments" asp-action="Index">
                            <i class="bi bi-cash-coin"></i>
                            <span>Payments &amp; Vouchers</span>
                        </a>
                    }
                    @if (User.HasPermission(PermissionCodes.ViewExpenses))
                    {
                        <a class="sidebar-link @(currentController == "Expenses" ? "active" : "")" asp-controller="Expenses" asp-action="Index">
                            <i class="bi bi-wallet2"></i>
                            <span>Expenses</span>
                        </a>
                    }
                }

                @if (User.HasPermission(PermissionCodes.DayClosing) || User.HasPermission(PermissionCodes.MonthlyClosing) || User.HasPermission(PermissionCodes.ViewReports))
                {
                    <div class="sidebar-section-label">Closing &amp; Reports</div>
                    @if (User.HasPermission(PermissionCodes.DayClosing))
                    {
                        <a class="sidebar-link @(currentController == "DayClosing" ? "active" : "")" asp-controller="DayClosing" asp-action="Index">
                            <i class="bi bi-calendar-check"></i>
                            <span>Day Closing</span>
                        </a>
                    }
                    @if (User.HasPermission(PermissionCodes.MonthlyClosing))
                    {
                        <a class="sidebar-link @(currentController == "MonthlyClosing" ? "active" : "")" asp-controller="MonthlyClosing" asp-action="Index">
                            <i class="bi bi-calendar3"></i>
                            <span>Monthly Closing</span>
                        </a>
                    }
                    @if (User.HasPermission(PermissionCodes.ViewReports))
                    {
                        <a class="sidebar-link @(currentController == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index">
                            <i class="bi bi-bar-chart-line"></i>
                            <span>Reports Center</span>
                        </a>
                    }
                }

                @if (User.HasPermission(PermissionCodes.ManageUsers) || User.HasPermission(PermissionCodes.ManageRoles) || User.HasPermission(PermissionCodes.ManageSettings) || User.HasPermission(PermissionCodes.ViewAuditLogs))
                {
                    <div class="sidebar-section-label">Administration</div>
                    @if (User.HasPermission(PermissionCodes.ManageUsers))
                    {
                        <a class="sidebar-link @(currentController == "Users" ? "active" : "")" asp-controller="Users" asp-action="Index">
                            <i class="bi bi-person-badge"></i>
                            <span>Users</span>
                        </a>
                    }
                    @if (User.HasPermission(PermissionCodes.ManageRoles))
                    {
                        <a class="sidebar-link @(currentController == "Roles" ? "active" : "")" asp-controller="Roles" asp-action="Index">
                            <i class="bi bi-shield-lock"></i>
                            <span>Roles</span>
                        </a>
                        <a class="sidebar-link @(currentController == "Permissions" ? "active" : "")" asp-controller="Permissions" asp-action="Index">
                            <i class="bi bi-key"></i>
                            <span>Permissions Matrix</span>
                        </a>
                    }
                    @if (User.HasPermission(PermissionCodes.ManageSettings))
                    {
                        <a class="sidebar-link @(currentController == "Settings" ? "active" : "")" asp-controller="Settings" asp-action="Index">
                            <i class="bi bi-gear"></i>
                            <span>Settings</span>
                        </a>
                    }
                    @if (User.HasPermission(PermissionCodes.ViewAuditLogs))
                    {
                        <a class="sidebar-link @(currentController == "AuditLogs" ? "active" : "")" asp-controller="AuditLogs" asp-action="Index">
                            <i class="bi bi-activity"></i>
                            <span>Audit Logs</span>
                        </a>
                    }
                }
            </nav>
        </aside>

        <!-- Main Workspace -->
        <div class="app-main">
            <header class="app-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary d-lg-none" onclick="document.getElementById('appSidebar').classList.toggle('show')">
                        <i class="bi bi-list"></i>
                    </button>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0 small">
                            <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
                            <li class="breadcrumb-item text-muted">@currentController</li>
                            <li class="breadcrumb-item active fw-semibold text-dark" aria-current="page">@(ViewData["Title"] ?? currentAction)</li>
                        </ol>
                    </nav>
                </div>

                <div class="d-flex align-items-center gap-2">
                    @if (User.HasPermission(PermissionCodes.CreateSale) && currentController != "POS")
                    {
                        <a asp-controller="POS" asp-action="Index" class="btn btn-sm btn-primary fw-semibold">
                            <i class="bi bi-upc-scan me-1"></i> Open POS
                        </a>
                    }
                    <div class="dropdown">
                        <button class="btn btn-sm btn-light border dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle text-primary"></i>
                            <span class="fw-semibold">@User.GetFullName()</span>
                            <span class="badge bg-secondary">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><span class="dropdown-item-text small text-muted">Signed in as <strong>@User.GetUsername()</strong></span></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item small" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2"></i>Change Password</a></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item small text-danger"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="app-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-3 py-2" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        <strong>@TempData["SuccessMessage"]</strong>
                        <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-3 py-2" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>@TempData["ErrorMessage"]</strong>
                        <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    @RenderBody()
}

<script src="~/vendor/jquery/jquery.min.js" asp-append-version="true"></script>
<script src="~/vendor/bootstrap/bootstrap.bundle.min.js" asp-append-version="true"></script>
<script src="~/vendor/chartjs/chart.umd.min.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
