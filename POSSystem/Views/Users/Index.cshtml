@model List<ApplicationUser>
@{
    ViewData["Title"] = "Users Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">System Users</h4>
        <span class="text-muted small">Manage Admin, Manager, Cashier, Inventory Manager and Accountant accounts</span>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm fw-semibold">
        <i class="bi bi-person-plus me-1"></i> Create New User
    </a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Assigned Role</th>
                    <th>Status</th>
                    <th>Last Login</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="fw-bold">@u.Username</td>
                        <td>@u.FullName</td>
                        <td>@u.Email</td>
                        <td><span class="badge bg-primary">@u.Role?.Name</span></td>
                        <td>
                            <span class="badge @(u.IsActive ? "bg-success" : "bg-danger")">@(u.IsActive ? "Active" : "Deactivated")</span>
                        </td>
                        <td>@(u.LastLogin?.ToString("yyyy-MM-dd HH:mm") ?? "Never")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-outline-primary"><i class="bi bi-pencil"></i> Edit</a>
                                @if (u.Username != "admin")
                                {
                                    <form asp-action="ToggleActive" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <button type="submit" class="btn @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                            @(u.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
