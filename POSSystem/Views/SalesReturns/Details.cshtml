@model SalesReturn
@{
    ViewData["Title"] = $"Sales Return {Model.ReturnNumber}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">Sales Return @Model.ReturnNumber</h4>
        <span class="text-muted small">Against Invoice <a asp-controller="Sales" asp-action="Details" asp-route-id="@Model.SaleId">@Model.Sale?.InvoiceNumber</a> | Date: @Model.ReturnDate.ToString("yyyy-MM-dd HH:mm")</span>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-dark btn-sm" onclick="window.print()"><i class="bi bi-printer me-1"></i> Print</button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to List</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold">Returned Items</h6>
            </div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="text-end">Returned Qty</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Tax Refund</th>
                            <th class="text-end">Refund Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@item.Product?.Name</div>
                                    <small class="text-muted">@item.Product?.SKU</small>
                                </td>
                                <td class="text-end fw-bold">@item.ReturnQuantity.ToString("N0")</td>
                                <td class="text-end">@item.UnitPrice.ToString("N2")</td>
                                <td class="text-end">@item.TaxAmount.ToString("N2")</td>
                                <td class="text-end fw-bold text-danger">@item.RefundAmount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold">Return Summary</h6>
            </div>
            <div class="card-body">
                <div class="mb-2 d-flex justify-content-between">
                    <span class="text-muted">Customer:</span>
                    <span class="fw-semibold">@(Model.Customer?.Name ?? "Walk-in Customer")</span>
                </div>
                <div class="mb-2 d-flex justify-content-between">
                    <span class="text-muted">Reason:</span>
                    <span>@Model.Reason</span>
                </div>
                <div class="mb-2 d-flex justify-content-between">
                    <span class="text-muted">Refund Method:</span>
                    <span class="badge bg-light text-dark border">@Model.RefundMethod</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between fs-5 fw-bold text-danger">
                    <span>Total Refund:</span>
                    <span>@Model.TotalRefundAmount.ToString("N2")</span>
                </div>
            </div>
        </div>
    </div>
</div>
