@model Product
@{
    ViewData["Title"] = $"Product Details - {Model.Name}";
    var movements = ViewBag.RecentMovements as List<StockMovement> ?? new List<StockMovement>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">@Model.Name</h4>
        <span class="text-muted small">SKU: <strong>@Model.SKU</strong> | Barcode: <strong>@Model.Barcode</strong> | Category: @(Model.Category?.Name ?? "-")</span>
    </div>
    <div class="d-flex gap-2">
        @if (User.HasPermission(PermissionCodes.EditProduct))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm fw-semibold"><i class="bi bi-pencil me-1"></i>Edit Product</a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Products</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold">Pricing &amp; Inventory Profile</h6>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Current Stock:</span>
                    <span class="fw-extrabold fs-5 @(Model.CurrentStock <= 0 ? "text-danger" : Model.CurrentStock <= Model.MinimumStockLevel ? "text-warning" : "text-success")">
                        @Model.CurrentStock.ToString("N0") @Model.Unit
                    </span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Opening Stock:</span>
                    <span>@Model.OpeningStock.ToString("N0") @Model.Unit</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Min Stock / Reorder:</span>
                    <span>@Model.MinimumStockLevel.ToString("N0") / @Model.ReorderLevel.ToString("N0")</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Cost Price:</span>
                    <span class="fw-semibold">@Model.CostPrice.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Retail Sale Price:</span>
                    <span class="fw-bold text-primary">@Model.SalePrice.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Wholesale Price:</span>
                    <span>@Model.WholesalePrice.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Minimum Sale Price:</span>
                    <span>@Model.MinimumSalePrice.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Tax Rate:</span>
                    <span>@Model.TaxRate%</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Default Supplier:</span>
                    <span>@(Model.DefaultSupplier?.CompanyName ?? "-")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">Product Stock Ledger Movements</h6>
                <a asp-controller="Inventory" asp-action="Ledger" asp-route-productId="@Model.Id" class="btn btn-sm btn-link text-decoration-none p-0">View Full Ledger</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Date / Time</th>
                            <th>Type</th>
                            <th>Reference #</th>
                            <th class="text-end">Qty In</th>
                            <th class="text-end">Qty Out</th>
                            <th class="text-end">Balance</th>
                            <th>User</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!movements.Any())
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4">No stock movements recorded yet.</td></tr>
                        }
                        @foreach (var m in movements)
                        {
                            <tr>
                                <td>@m.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td><span class="badge bg-light text-dark border">@m.TransactionType</span></td>
                                <td class="fw-semibold">@m.ReferenceNumber</td>
                                <td class="text-end text-success fw-semibold">@(m.QuantityIn > 0 ? $"+{m.QuantityIn:N0}" : "-")</td>
                                <td class="text-end text-danger fw-semibold">@(m.QuantityOut > 0 ? $"-{m.QuantityOut:N0}" : "-")</td>
                                <td class="text-end fw-bold">@m.BalanceAfter.ToString("N0")</td>
                                <td>@(m.User?.Username ?? "System")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
