@model Sale
@{
    ViewData["Title"] = $"Sale Invoice {Model.InvoiceNumber}";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h4 class="fw-bold mb-0">Invoice @Model.InvoiceNumber</h4>
        <span class="text-muted small">Date: @Model.SaleDate.ToString("yyyy-MM-dd HH:mm:ss") | Cashier: @(Model.Cashier?.FullName ?? "System")</span>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Receipt" asp-route-id="@Model.Id" asp-route-format="Thermal" class="btn btn-primary btn-sm fw-semibold">
            <i class="bi bi-printer me-1"></i> Thermal Receipt
        </a>
        <a asp-action="Receipt" asp-route-id="@Model.Id" asp-route-format="A4" class="btn btn-outline-dark btn-sm fw-semibold">
            <i class="bi bi-file-earmark-richtext me-1"></i> A4 Invoice
        </a>
        @if (Model.Status != "Cancelled" && User.HasPermission(PermissionCodes.SalesReturn))
        {
            <a asp-controller="SalesReturns" asp-action="Create" asp-route-saleId="@Model.Id" class="btn btn-warning btn-sm fw-semibold">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Sales Return
            </a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Sales</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">Invoice Line Items</h6>
                <span class="badge @(Model.Status == "Completed" ? "bg-success" : Model.Status == "Cancelled" ? "bg-danger" : "bg-warning text-dark")">@Model.Status</span>
            </div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Returned</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Discount</th>
                            <th class="text-end">Tax</th>
                            <th class="text-end">Line Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@(item.Product?.Name ?? $"Product #{item.ProductId}")</div>
                                    <small class="text-muted">SKU: @(item.Product?.SKU ?? "-") @(item.IsPriceOverridden ? "(Price Overridden)" : "")</small>
                                </td>
                                <td class="text-end fw-semibold">@item.Quantity.ToString("N0")</td>
                                <td class="text-end @(item.ReturnedQuantity > 0 ? "text-danger fw-bold" : "text-muted")">@item.ReturnedQuantity.ToString("N0")</td>
                                <td class="text-end">@item.UnitPrice.ToString("N2")</td>
                                <td class="text-end">@item.DiscountAmount.ToString("N2")</td>
                                <td class="text-end">@item.TaxAmount.ToString("N2") (@item.TaxRate%)</td>
                                <td class="text-end fw-bold">@item.LineTotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.Status != "Cancelled" && User.HasPermission(PermissionCodes.CancelSale))
        {
            <div class="card border-danger-subtle">
                <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <h6 class="fw-bold text-danger mb-0">Void / Cancel Invoice</h6>
                        <small class="text-muted">Cancelling this invoice will restore unsold stock quantities to inventory and adjust customer balance.</small>
                    </div>
                    <form asp-action="Cancel" method="post" class="d-flex gap-2" onsubmit="return confirm('Are you sure you want to void this sale invoice and reverse inventory?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="text" name="reason" class="form-control form-control-sm" placeholder="Reason for voiding..." required style="width: 220px;" />
                        <button type="submit" class="btn btn-sm btn-danger fw-semibold">Void Invoice</button>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold">Financial Summary &amp; Customer</h6>
            </div>
            <div class="card-body">
                <div class="mb-3 pb-2 border-bottom">
                    <div class="small text-muted">Customer</div>
                    <div class="fw-bold">@(Model.Customer?.Name ?? "Walk-in Customer")</div>
                    <div class="small text-muted">Price Tier: @Model.PriceTier | Payment Method: @Model.PaymentMethod</div>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Subtotal:</span>
                    <span class="fw-semibold">@Model.SubTotal.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Total Discount:</span>
                    <span class="text-danger">-@Model.DiscountAmount.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Total Tax:</span>
                    <span>@Model.TaxAmount.ToString("N2")</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between fs-5 fw-bold mb-2">
                    <span>Grand Total:</span>
                    <span class="text-primary">@Model.TotalAmount.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Amount Paid:</span>
                    <span class="text-success fw-semibold">@Model.PaidAmount.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Change Returned:</span>
                    <span>@Model.ChangeAmount.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Balance Due:</span>
                    <span class="@(Model.DueAmount > 0 ? "text-danger fw-bold" : "text-muted")">@Model.DueAmount.ToString("N2")</span>
                </div>
                @if (Model.DueAmount > 0 && Model.CustomerId.HasValue && User.HasPermission(PermissionCodes.CreatePayment))
                {
                    <div class="mt-3">
                        <a asp-controller="Payments" asp-action="Create" asp-route-customerId="@Model.CustomerId" asp-route-paymentType="CustomerReceipt" class="btn btn-sm btn-success w-100 fw-semibold">
                            <i class="bi bi-cash-coin me-1"></i> Collect Due Balance
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
