@model PurchaseOrder
@{
    ViewData["Title"] = $"Purchase Order {Model.PONumber}";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h4 class="fw-bold mb-0">Purchase Order @Model.PONumber</h4>
        <span class="text-muted small">Supplier: <strong>@Model.Supplier?.CompanyName</strong> | Date: @Model.OrderDate.ToString("yyyy-MM-dd")</span>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Status != "FullyReceived" && Model.Status != "Cancelled" && User.HasPermission(PermissionCodes.ReceiveGoods))
        {
            <a asp-controller="GoodsReceiving" asp-action="Create" asp-route-purchaseOrderId="@Model.Id" class="btn btn-success btn-sm fw-bold">
                <i class="bi bi-box-arrow-in-down me-1"></i> Convert to Goods Receiving (GRN)
            </a>
        }
        @if (Model.Status == "Draft" && User.HasPermission(PermissionCodes.ApprovePurchase))
        {
            <form asp-action="UpdateStatus" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="status" value="Ordered" />
                <button type="submit" class="btn btn-primary btn-sm fw-semibold">Approve &amp; Mark Ordered</button>
            </form>
        }
        @if (!Model.GoodsReceipts.Any() && Model.Status != "Cancelled" && User.HasPermission(PermissionCodes.ApprovePurchase))
        {
            <form asp-action="UpdateStatus" method="post" class="d-inline" onsubmit="return confirm('Cancel this purchase order?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="status" value="Cancelled" />
                <button type="submit" class="btn btn-outline-danger btn-sm">Cancel PO</button>
            </form>
        }
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to POs</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">Ordered Items</h6>
                <span class="badge @(Model.Status == "FullyReceived" ? "bg-success" : Model.Status == "Cancelled" ? "bg-danger" : "bg-primary")">@Model.Status</span>
            </div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="text-end">Ordered Qty</th>
                            <th class="text-end">Received Qty</th>
                            <th class="text-end">Cost Price</th>
                            <th class="text-end">Discount</th>
                            <th class="text-end">Tax</th>
                            <th class="text-end">Line Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@item.Product?.Name</div>
                                    <small class="text-muted">@item.Product?.SKU</small>
                                </td>
                                <td class="text-end fw-semibold">@item.OrderedQuantity.ToString("N0")</td>
                                <td class="text-end text-success fw-bold">@item.ReceivedQuantity.ToString("N0")</td>
                                <td class="text-end">@item.CostPrice.ToString("N2")</td>
                                <td class="text-end">@item.DiscountAmount.ToString("N2")</td>
                                <td class="text-end">@item.TaxAmount.ToString("N2")</td>
                                <td class="text-end fw-bold">@item.LineTotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold">Order Totals</h6>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Subtotal:</span>
                    <span>@Model.SubTotal.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Discount:</span>
                    <span>-@Model.DiscountAmount.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Tax:</span>
                    <span>@Model.TaxAmount.ToString("N2")</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between fs-5 fw-bold text-primary">
                    <span>Total Amount:</span>
                    <span>@Model.TotalAmount.ToString("N2")</span>
                </div>
            </div>
        </div>
    </div>
</div>
