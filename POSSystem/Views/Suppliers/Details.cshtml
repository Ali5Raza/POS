@model SupplierDetailsViewModel
@{
    ViewData["Title"] = $"Supplier Ledger - {Model.Supplier.CompanyName}";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h4 class="fw-bold mb-0">@Model.Supplier.CompanyName</h4>
        <span class="text-muted small">Contact: @Model.Supplier.Name | Phone: @Model.Supplier.Phone | NTN: @(Model.Supplier.TaxNumber ?? "-")</span>
    </div>
    <div class="d-flex gap-2">
        @if (User.HasPermission(PermissionCodes.CreatePayment))
        {
            <a asp-controller="Payments" asp-action="Create" asp-route-supplierId="@Model.Supplier.Id" asp-route-paymentType="SupplierPayment" class="btn btn-success btn-sm fw-semibold">
                <i class="bi bi-cash-coin me-1"></i> Record Supplier Payment
            </a>
        }
        <a asp-action="Edit" asp-route-id="@Model.Supplier.Id" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i>Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Suppliers</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="kpi-card">
            <div class="kpi-label">Opening Balance</div>
            <div class="kpi-value">@Model.Supplier.OpeningBalance.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="kpi-card">
            <div class="kpi-label">Total Purchases (GRNs)</div>
            <div class="kpi-value text-primary">@Model.Purchases.Sum(p => p.TotalAmount).ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="kpi-card">
            <div class="kpi-label">Current Payable Balance</div>
            <div class="kpi-value @(Model.Supplier.CurrentBalance > 0 ? "text-danger" : "text-success")">@Model.Supplier.CurrentBalance.ToString("N2")</div>
        </div>
    </div>
</div>

<!-- Supplier Ledger -->
<div class="card mb-3">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold"><i class="bi bi-journal-text me-2 text-primary"></i>Supplier Financial Ledger</h6>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer me-1"></i>Print Ledger</button>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Transaction Type</th>
                    <th>Reference #</th>
                    <th>Description</th>
                    <th class="text-end">Debit (Paid/Returned)</th>
                    <th class="text-end">Credit (Purchased)</th>
                    <th class="text-end">Running Payable Balance</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Ledger.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No ledger transactions recorded yet.</td></tr>
                }
                @foreach (var entry in Model.Ledger)
                {
                    <tr>
                        <td>@entry.Date.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><span class="badge bg-light text-dark border">@entry.TransactionType</span></td>
                        <td class="fw-semibold">@entry.ReferenceNumber</td>
                        <td>@entry.Description</td>
                        <td class="text-end text-success">@(entry.Debit > 0 ? entry.Debit.ToString("N2") : "-")</td>
                        <td class="text-end text-danger">@(entry.Credit > 0 ? entry.Credit.ToString("N2") : "-")</td>
                        <td class="text-end fw-bold">@entry.RunningBalance.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
