@model SupplierViewModel
@{
    ViewData["Title"] = $"Edit Supplier - {Model.CompanyName}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0">Edit Supplier: @Model.CompanyName</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Suppliers</a>
</div>

<div class="card">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        <form asp-action="Edit" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="col-md-6">
                <label asp-for="CompanyName" class="form-label small fw-bold">Company Name *</label>
                <input asp-for="CompanyName" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label asp-for="Name" class="form-label small fw-bold">Supplier Contact Person *</label>
                <input asp-for="Name" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label asp-for="Phone" class="form-label small fw-bold">Phone *</label>
                <input asp-for="Phone" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label asp-for="Email" class="form-label small fw-bold">Email</label>
                <input asp-for="Email" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="TaxNumber" class="form-label small fw-bold">NTN / CNIC</label>
                <input asp-for="TaxNumber" class="form-control" />
            </div>
            <div class="col-md-8">
                <label asp-for="Address" class="form-label small fw-bold">Address</label>
                <input asp-for="Address" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="OpeningBalance" class="form-label small fw-bold">Opening Balance</label>
                <input asp-for="OpeningBalance" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-9">
                <label asp-for="Notes" class="form-label small fw-bold">Notes</label>
                <input asp-for="Notes" class="form-control" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label fw-semibold">Active Supplier</label>
                </div>
            </div>
            <div class="col-12 d-flex justify-content-end gap-2 pt-2 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary fw-bold px-4">Update Supplier</button>
            </div>
        </form>
    </div>
</div>
